// Prisma 7 — URL dikelola via prisma.config.ts, bukan di sini
// See: https://pris.ly/d/config-datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ScorPhase {
  Plan
  Source
  Make
  Deliver
  Return
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  name      String
  password  String
  division  String   @default("Divisi Produksi")
  role      String   @default("Operator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HOR Fase 1 — Risk Event (E): kejadian risiko, punya Severity
model RiskEvent {
  id           Int           @id @default(autoincrement())
  code_e       String        @unique
  description  String
  severity     Int                             // S: skala 1-10
  scor_phase   ScorPhase
  year         Int           @default(2026)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  correlations Correlation[]
}

// HOR Fase 1 — Risk Agent (A): agen/penyebab risiko, punya Occurrence
model RiskAgent {
  id                 Int                 @id @default(autoincrement())
  code_pa            String              @unique           // e.g. "A1", "A2"
  description        String
  occurrence         Int                                   // O: skala 1-10
  arp_score          Float               @default(0)       // ARP = O x S(S*R), dihitung server
  scor_phase         ScorPhase
  code_pa_ref        String              @default("")
  year               Int                 @default(2026)
  rank               Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  correlations       Correlation[]
  actionCorrelations ActionCorrelation[]
}

// HOR Fase 1 — Correlation: matriks relasi Event dan Agent
model Correlation {
  id       Int       @id @default(autoincrement())
  event_id Int
  agent_id Int
  r_value  Int       @default(0)     // Nilai R: 0, 1, 3, atau 9
  event    RiskEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  agent    RiskAgent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([event_id, agent_id])
}

// HOR Fase 2 — PreventiveAction (PA): tindakan pencegahan dengan Degree of Difficulty
model PreventiveAction {
  id           Int                 @id @default(autoincrement())
  code_action  String              @unique           // e.g. "PA1", "PA2"
  description  String
  difficulty   Int                                   // D: 3 (Rendah), 4 (Sedang), 5 (Tinggi)
  scor_phase   ScorPhase?
  te_score     Float               @default(0)       // TE = Sum(ARP_j * R_jk), dihitung server
  etd_score    Float               @default(0)       // ETD = TE / D, hasil akhir HOR 2
  rank         Int                 @default(0)
  year         Int                 @default(2026)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  correlations ActionCorrelation[]
}

// HOR Fase 2 — ActionCorrelation: matriks relasi Agent dan PreventiveAction
model ActionCorrelation {
  id        Int              @id @default(autoincrement())
  agent_id  Int
  action_id Int
  r_value   Int              @default(0)   // Nilai R: 0, 1, 3, atau 9
  agent     RiskAgent        @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  action    PreventiveAction @relation(fields: [action_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, action_id])
}

model ProductionMetric {
  id          Int    @id @default(autoincrement())
  month       String
  short_month String @default("")
  year        Int
  rainfall_mm Float
  raw_tea_ton Float
  dry_tea_ton Float

  @@unique([month, year])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  division  String
  action    String
  createdAt DateTime @default(now())
}
